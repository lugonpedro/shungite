# Copie para .env.local nesta mesma pasta (apps/app) e preencha com as
# credenciais do Supabase.
# Nada aqui é secreto o bastante para commitar: use placeholders e deixe o
# .env.local (ignorado pelo git) com os valores reais.
#
# Local (`supabase status` mostra os dois valores):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<ANON_KEY>
#
# Hospedado (Project Settings → API no painel do Supabase):
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon-public-key>
#
# Apenas a chave anon/public entra aqui. Nunca use a service_role key: toda
# variável VITE_* é embutida no bundle público.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
