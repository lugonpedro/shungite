{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shungite",
  "version": "0.0.1",
  "identifier": "com.lugonpedro.shungite",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Shungite", "width": 900, "height": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "iOS": { "minimumSystemVersion": "15.0" }
  }
}
